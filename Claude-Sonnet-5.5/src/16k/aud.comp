#version 430
layout(local_size_x=64) in;
layout(std430,binding=0) buffer B{vec4 o[];};      // xy = dry mix, zw = reverb send
const float P=6.2831853,BT=.46875,SX=.1171875,BAR=1.875;
float N,N1,I0;                                   // white noise now / one sample ago, sample index

float fq(float n){return 73.416*exp2(n/12.);}   // n semitones above D2
float blep(float t,float dt){if(t<dt){t/=dt;return t+t-t*t-1.;}if(t>1.-dt){t=(t-1.)/dt;return t*t+t+t+1.;}return 0.;}
float saw(float f,float t){float dt=f/48000.,ph=fract(f*t);return 2.*ph-1.-blep(ph,dt);}
float sn(float f,float t){return sin(P*fract(f*t));}
// low-passed noise: moving average of M samples (cutoff falls as M grows)
float lpn(int M){float s=0.;for(int m=0;m<M;m++)s+=F(uint(I0)*2u+1u-uint(m)*2u)*2.-1.;return s*inversesqrt(float(M));}

// ---- harmony: Dm | Bb | F | C, one chord per bar
float rt(float b){float c=mod(b,4.);return c<1.?0.:c<2.?-4.:c<3.?3.:-2.;}
float th(float b){return mod(b,4.)<1.?3.:4.;}
float tone(float b,int i){float t=th(b);return i==0?0.:i==1?t:i==2?7.:i==3?12.:i==4?12.+t:19.;}

// ---- drums
float kick(float t){return t<0.?0.:(sin(P*(50.*t+8.*(1.-exp(-30.*t))))*exp(-t*8.)+.5*N*exp(-t*200.))*.9;}
float clap(float t){if(t<0.)return 0.;float s=0.;for(int j=0;j<3;j++)s+=exp(-max(t-float(j)*.012,0.)*30.)*step(float(j)*.012,t);return N*s*.25*exp(-t*8.)+sn(190.,t)*exp(-t*30.)*.3;}
float hat(float t,float d){return t<0.?0.:(N-N1)*exp(-t*d);}

// ---- melodic layers (functions of absolute time so that the reverb can re-evaluate them)
float pluck(float f,float t){if(t<0.)return 0.;float s=0.;for(int k=1;k<6;k++)s+=sin(P*fract(f*float(k)*t))/float(k)*exp(-t*(4.+6.*float(k)));return s;}
vec2 arp(float t){
  float O=ORD(t),g=smoothstep(11.,15.,t)*(1.-smoothstep(41.,43.,t)*(1.-step(45.,t)))+step(45.,t)*.0;
  float st=floor(t/SX);vec2 r=vec2(0.);
  for(int j=0;j<5;j++){
    float k=st-float(j),b=floor(k/16.);
    float q=mod(k,6.);int i=int(q<1.?0.:q<2.?1.:q<3.?2.:q<4.?3.:q<5.?2.:1.);
    float n=rt(b)+24.+tone(b,i)+(1.-O)*(F(k+5.)-.5)*6.;
    float v=pluck(fq(n),t-k*SX-(1.-O)*(F(k+9.)-.5)*.1)*.55;
    float pan=.5+.4*sin(k*1.7);
    r+=v*vec2(1.-pan,pan);
  }
  return r*g;
}
vec2 pad(float t){
  float O=ORD(t),g=smoothstep(22.,30.,t)*(1.-smoothstep(41.,43.,t)*(1.-step(45.,t)));
  g+=smoothstep(44.,46.,t)*.4;
  float bar=floor(t/BAR);vec2 r=vec2(0.);
  for(int j=0;j<2;j++){
    float b=bar-float(j),tb=t-b*BAR;
    float e=smoothstep(0.,.5,tb)*(1.-smoothstep(BAR-.1,BAR+.5,tb));
    for(int i=0;i<4;i++){
      float f=fq(rt(b)+12.+tone(b,i));
      r+=vec2(saw(f*.997,tb)+saw(f*1.003,tb)*.5,saw(f*1.003,tb)+saw(f*.997,tb)*.5)*e*.1;
    }
  }
  return r*g;
}
vec2 lead(float t){
  float g=smoothstep(30.,31.,t)*(1.-smoothstep(38.,39.,t))+smoothstep(45.,45.2,t)*(1.-smoothstep(56.,56.4,t));
  float st=floor(t/(BT/2.)),b=floor(t/BAR);vec2 r=vec2(0.);
  float ph=mod(st,8.);
  // 8th-note motif in chord tones, rests marked by 9
  float m=ph<1.?2.:ph<2.?9.:ph<3.?3.:ph<4.?9.:ph<5.?4.:ph<6.?9.:ph<7.?3.:2.;
  if(m<8.){
    float tl=t-st*BT/2.;
    float f=fq(rt(b)+24.+tone(b,int(m)));
    float e=smoothstep(0.,.01,tl)*exp(-tl*4.);
    float s=saw(f*(1.+.004*sin(P*5.5*tl)),tl)+.5*sn(f*.5,tl);
    r=vec2(s*e*.3);
  }
  return r*g;
}
vec2 bus(float t){return pad(t)+arp(t)+lead(t);}

void main(){
  uint i=gl_GlobalInvocationID.x;
  float t=float(i)/48000.;I0=float(i);
  N=F(i*2u+1u)*2.-1.;N1=F((i-1u)*2u+1u)*2.-1.;
  float O=ORD(t),S=STA(t);
  vec2 m=vec2(0.);
  // ---- static bed, clicks, drone
  m+=lpn(4)*.22*S*(.5+.5*sin(t*.7))+N*.05*S;
  m+=N*CK(t)*.5;
  float dr=smoothstep(3.,12.,t)*(1.-.7*smoothstep(15.,17.,t))*(1.-.6*step(56.,t));
  m+=(sn(fq(0.),t)*.1+sn(fq(7.)*1.002,t)*.05+sn(fq(12.)*.998,t)*.04)*dr*(.7+.3*sin(t*.5));
  // ---- kicks
  float kd=0.,k0=floor(t/BT);
  for(int j=0;j<3;j++){float k=k0+1.-float(j);kd+=kick(t-KT(k))*KV(k);}
  m+=kd*.42;
  float duck=1.-.55*KE(t);
  // ---- hats and clap
  float sp=fract(t/SX),sk=floor(t/SX);
  float hh=step(15.,t)*hat(fract(t/BT+.5)*BT,60.)*.3*(1.-step(41.,t)*(1.-step(45.,t)))+step(23.,t)*hat(sp*SX,180.)*.12*step(.5,F(sk+33.)+.5);
  m+=hh*.7;
  float bt=floor(t/BT);
  m+=clap(mod(t,BT*2.)-BT)*step(30.,t)*step(mod(bt,2.),.5)*(1.-step(41.,t)*(1.-step(45.,t)))*.5;
  // ---- bass: 8th-note pattern on the chord root
  float bn=floor(t/(BT/2.)),bb=floor(t/BAR),bl=t-bn*BT/2.;
  float bp=mod(bn,8.);
  float on=step(.5,bp<1.?1.:bp<2.?0.:bp<3.?1.:bp<4.?1.:bp<5.?0.:bp<6.?1.:bp<7.?0.:1.);
  float bg=(smoothstep(17.,19.,t)*(1.-step(41.,t))+step(45.,t))*step(t,58.);
  float bf=fq(rt(bb)+(mod(bn,8.)>5.5?12.:0.));
  float bass=(saw(bf,bl)*.6+sn(bf,bl)*.45)*on*exp(-bl*5.)*smoothstep(0.,.005,bl);
  m+=bass*.34*bg*duck;
  // ---- breakdown: riser and snare roll, impacts at phrase boundaries
  float rs=smoothstep(38.,45.,t)*(1.-step(45.,t));
  m+=lpn(int(mix(48.,2.,rs*rs)))*rs*.25;
  float rl=t-42.5;float roll=step(0.,rl)*step(rl,2.5)*clap(mod(rl,mix(.24,.06,rl/2.5)))*.5;
  m+=roll;
  float pb=mod(t,7.5);
  m+=N*exp(-pb*3.)*.12*step(14.9,t)*step(t,46.);   // crash at each phrase start
  // ---- harmony bus with reverb taps
  float ED=3.*SX;                                   // dotted-eighth echo (ping-pong) on the plucks and the lead
  vec2 h=(bus(t)+(arp(t-ED)+lead(t-ED)).yx*.4+(arp(t-2.*ED)+lead(t-2.*ED))*.2)*duck*smoothstep(4.,10.,t);
  vec2 snd=h*1.3+clap(mod(t,BT*2.)-BT)*step(30.,t)*.15;
  m+=h;
  // ---- the drop: sub boom, and one plucked note per letter of the word (Dm arpeggio D F A D F on the beats)
  float bd=t-45.;
  float bm=step(0.,bd)*(sin(P*(70.*bd-25.*(1.-exp(-max(bd,0.)*2.))))*exp(-max(bd,0.)*1.1)*.5+N*exp(-max(bd,0.)*3.)*.2);
  m+=vec2(bm);snd+=vec2(bm)*.4;
  for(int q=0;q<5;q++){float lt=t-45.-float(q)*BT;float nn=q<1?24.:q<2?27.:q<3?31.:q<4?36.:39.;float pk=pluck(fq(nn),lt)*.5+pluck(fq(nn+12.),lt)*.2;m+=vec2(pk);snd+=vec2(pk)*1.3;}
  // ---- final chord: D major, sustained, and a last crash
  float ft=t-56.25;
  if(ft>0.){
    float e=smoothstep(0.,.05,ft)*exp(-ft*.7);
    for(int q=0;q<4;q++){float f=fq(float(q<1?0:q<2?4:q<3?7:12)+12.);{vec2 fc=vec2(saw(f*.996,ft),saw(f*1.004,ft))*e*.09;m+=fc;snd+=fc*1.4;}}
    m+=N*exp(-ft*2.)*.2;
  }
  o[i]=vec4(m,snd);
}
