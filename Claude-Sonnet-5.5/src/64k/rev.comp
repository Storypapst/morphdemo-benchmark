#version 430
layout(local_size_x=64) in;
layout(std430,binding=0) buffer A{vec4 a[];};      // dry + send
layout(std430,binding=1) buffer B{vec2 o[];};      // final stereo
layout(location=1) uniform int base;
// convolution with an exponentially decaying noise impulse response (two decorrelated ones for L and R)
void main(){
  uint i=gl_GlobalInvocationID.x+uint(base);
  vec2 acc=vec2(0.);
  int M=int(min(i,uint(100000)));
  for(int m=1;m<M;m++){
    vec4 s=a[i-uint(m)];
    float e=exp(-float(m)*.000042)*(1.-exp(-float(m)*.004));
    float nl=F(uint(m)*2u+11u)*2.-1.,nr=F(uint(m)*2u+70001u)*2.-1.;
    acc+=vec2(s.z*nl,s.w*nr)*e;
  }
  vec4 d=a[i];
  vec2 m=d.xy+acc*.0075;
  float t=float(i)/48000.;
  m*=1.-.97*smoothstep(44.68,44.72,t)*(1.-smoothstep(44.98,45.,t));   // a breath of silence before the drop
  m=tanh(m*1.5)*.7;
  m*=min(t*20.,1.)*(1.-smoothstep(58.6,60.,t));
  o[i]=m;
}
